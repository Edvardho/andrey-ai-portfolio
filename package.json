    "test:runtime": "tsx scripts/runtime-browser-smoke.ts",
    "eval:intents": "tsx scripts/eval-intents.ts",
    "eval:intents:objections": "tsx scripts/eval-intents.ts objections",
    "eval:intents:objections:core": "tsx scripts/eval-intents.ts objections-core",
    "verify:vocabulary": "tsx scripts/verify-vocabulary.ts",
    "verify": "npm run typecheck && npm run smoke && npm run verify:case-layout && npm run verify:structured-summary && npm run verify:structured-experience && npm run verify:vocabulary"
