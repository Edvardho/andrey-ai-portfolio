    "verify:case-layout": "tsx scripts/case-layout-contract.ts",
    "verify:structured-summary": "tsx scripts/structured-summary-contract.ts",
    "verify:structured-experience": "tsx scripts/structured-experience-contract.ts",
    "verify:intent-policy": "tsx scripts/verify-intent-policy.ts",
    "verify:query-interpretation": "node --import tsx scripts/verify-query-interpretation.ts",
    "verify:design-lead-questions": "node --import tsx scripts/verify-design-lead-questions.ts",
